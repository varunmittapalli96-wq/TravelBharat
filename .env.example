# =====================
# TravelBharat Environment Variables
# =====================

# Database
DATABASE_URL="postgresql://travelbharat:travelbharat@localhost:5432/travelbharat?schema=public"

# API
API_PORT=4000
API_URL=http://localhost:4000
NODE_ENV=development

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Auth (generate with: openssl rand -base64 64)
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_EXPIRES_IN=7d

# Admin seed credentials
ADMIN_EMAIL=admin@travelbharat.in
ADMIN_PASSWORD=Admin@TravelBharat2024!

# CORS
CORS_ORIGINS=http://localhost:3000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=5
